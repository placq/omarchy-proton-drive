pkgname=omarchy-drive
pkgver=1.0.2
pkgrel=1
pkgdesc="Unofficial Proton Drive desktop integration for Omarchy Quattro"
arch=('any')
url="https://github.com/placq/omarchy-proton-drive"
license=('MIT')
depends=('bun' 'fuse3' 'gnome-desktop-4' 'libsecret' 'nautilus' 'nautilus-python' 'python-dbus-next' 'python-pyfuse3' 'python-trio')
options=('!strip')
source=()
sha256sums=()

package() {
  local src="$startdir/../.."
  install -d "$pkgdir/usr/lib/omarchy-drive" "$pkgdir/usr/bin"
  cp -a "$src/daemon" "$src/filesystem" "$src/ipc" "$src/package.json" "$pkgdir/usr/lib/omarchy-drive/"
  install -Dm755 "$src/scripts/omarchy-drive-control" "$pkgdir/usr/bin/omarchy-drive-control"
  install -Dm644 "$src/nautilus/extension/omarchy_drive.py" "$pkgdir/usr/share/nautilus-python/extensions/omarchy_drive.py"
  install -Dm644 "$src/nautilus/extension/drive_logic.py" "$pkgdir/usr/share/nautilus-python/extensions/drive_logic.py"
  install -Dm644 "$src/systemd/omarchy-drive.service" "$pkgdir/usr/lib/systemd/user/omarchy-drive.service"
  install -Dm644 "$src/systemd/omarchy-drive-mount.service" "$pkgdir/usr/lib/systemd/user/omarchy-drive-mount.service"
  install -Dm644 "$src/systemd/omarchy-drive-dbus.service" "$pkgdir/usr/lib/systemd/user/omarchy-drive-dbus.service"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  chmod 755 "$pkgdir/usr/lib/omarchy-drive/filesystem/fuse/omarchy-drive-fuse.py"
  chmod 755 "$pkgdir/usr/lib/omarchy-drive/ipc/dbus/omarchy_drive_dbus.py"
  rm -rf "$pkgdir/usr/lib/omarchy-drive/daemon/tests"
  find "$pkgdir/usr/lib/omarchy-drive/ipc" -type f -name 'test_*.py' -delete
  find "$pkgdir/usr/lib/omarchy-drive" -type d -name __pycache__ -prune -exec rm -rf {} +
}
