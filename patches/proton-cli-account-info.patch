--- /dev/null
+++ b/cli/src/commands/account/commandAccountInfo.ts
@@ -0,0 +1,36 @@
+import { type ActionArgs, type Command, printObject } from '../../cli';
+
+type UserResponse = {
+    User?: {
+        Email?: string;
+        DisplayName?: string;
+        MaxSpace?: number;
+        UsedSpace?: number;
+        ProductUsedSpace?: { Drive?: number };
+    };
+};
+
+export class CommandAccountInfo implements Command {
+    group = 'account';
+    name = 'info';
+    help = 'Shows the signed-in account and Drive storage usage.';
+
+    async action({ apiClient, options: { json } }: ActionArgs) {
+        const response = await apiClient.authenticatedRequest
+            .get(`${apiClient.baseUrlWithProtocol}/core/v4/users`)
+            .json<UserResponse>();
+        const user = response.User;
+        if (!user) {
+            throw new Error('Proton account response did not contain a user');
+        }
+        printObject(
+            {
+                email: user.Email ?? '',
+                displayName: user.DisplayName ?? '',
+                usedBytes: user.ProductUsedSpace?.Drive ?? user.UsedSpace ?? 0,
+                totalBytes: user.MaxSpace ?? 0,
+            },
+            json,
+        );
+    }
+}
