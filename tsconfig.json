{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "daemon/**/*.ts"
  ],
  "paths": {
    "proton-drive-sdk-account": [
      "vendor/proton-drive-sdk-account/src/index.ts"
    ]
  },
  "exclude": [
    "vendor/**/provenance-package.json",
    "daemon/src/sdk-client.ts"
  ]
}