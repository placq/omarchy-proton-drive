#!/usr/bin/env python3
import argparse, json, os, socket, subprocess, sys
from pathlib import Path

source_root = Path(__file__).resolve().parents[1]
library_root = source_root if (source_root / "ipc/rpc_client.py").is_file() else source_root / "lib/omarchy-drive"
sys.path.insert(0, str(library_root))
from ipc.rpc_client import RpcClient

SOCKET = os.environ.get("OMARCHY_DRIVE_SOCKET", f"{os.environ.get('XDG_RUNTIME_DIR', '/tmp')}/omarchy-drive.sock")
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", str(Path.home()/".local/share")))
RPC_CLIENT = RpcClient(SOCKET)
AUTH_UNITS = ["omarchy-drive-mount.service", "omarchy-drive-dbus.service", "omarchy-drive.service"]

def call(method, **params):
    return RPC_CLIENT.call(method, **params)

def authenticate(command, cli, runner=subprocess.run):
    try:
        # The upstream CLI owns one shared on-disk session/cache. Ensure no
        # daemon or filesystem command can overlap an auth mutation.
        runner(["systemctl", "--user", "stop", *AUTH_UNITS], check=True)
        runner([cli, "auth", command], check=True)
    finally:
        runner(["systemctl", "--user", "start", "omarchy-drive.service", "omarchy-drive-dbus.service", "omarchy-drive-mount.service"], check=False)

def main():
    p=argparse.ArgumentParser(); sub=p.add_subparsers(dest="command", required=True)
    sub.add_parser("status"); sub.add_parser("transfers"); sub.add_parser("sync"); sub.add_parser("watch"); sub.add_parser("clear-cache"); sub.add_parser("clear-pinned-cache"); sub.add_parser("logs")
    sub.add_parser("login"); sub.add_parser("logout")
    open_p=sub.add_parser("open"); open_p.add_argument("path", nargs="?")
    for name in ["pin","unpin","evict","retry","node-status"]:
        q=sub.add_parser(name); q.add_argument("node_id")
    for name in ["conflict-keep-local", "conflict-keep-remote", "conflict-save-both"]:
        q=sub.add_parser(name); q.add_argument("node_id"); q.add_argument("--name", default="")
    cancel_p=sub.add_parser("cancel-transfer"); cancel_p.add_argument("transfer_id")
    a=p.parse_args()
    if a.command in {"login", "logout"}:
        cli=os.environ.get("OMARCHY_DRIVE_CLI", str(Path.home()/".local/bin/proton-drive"))
        authenticate(a.command, cli)
        print(json.dumps({"authenticated": a.command == "login"})); return
    if a.command == "watch":
        req=(json.dumps({"id":1,"method":"Watch","params":{}})+"\n").encode()
        with socket.socket(socket.AF_UNIX) as conn:
            conn.connect(SOCKET); conn.sendall(req); stream=conn.makefile("r")
            for line in stream: print(line, end="", flush=True)
        return
    if a.command == "logs":
        log_dir=Path(os.environ.get("XDG_CACHE_HOME", str(Path.home()/".cache")))/"omarchy-drive"/"logs"
        log_dir.mkdir(parents=True, exist_ok=True, mode=0o700); log_path=log_dir/"omarchy-drive.log"
        units=["omarchy-drive.service", "omarchy-drive-dbus.service", "omarchy-drive-mount.service"]
        journal_command=["journalctl", "--user", "--since", "24 hours ago", "--no-pager", "-o", "short-iso"]
        for unit in units: journal_command.extend(["-u", unit])
        service_log=subprocess.run(journal_command, capture_output=True, text=True, check=False).stdout
        shell_log=subprocess.run(["journalctl", "--user", "--since", "24 hours ago", "--no-pager", "-o", "short-iso"], capture_output=True, text=True, check=False).stdout
        markers=("placq.proton-drive", "proton drive", "barwidget.qml", "service.qml")
        plugin_lines="\n".join(line for line in shell_log.splitlines() if any(marker in line.lower() for marker in markers))
        log_path.write_text("Proton Drive for Omarchy — last 24 hours\n\nSERVICES\n"+service_log+"\nPLUGIN UI\n"+plugin_lines+"\n", encoding="utf-8")
        log_path.chmod(0o600)
        subprocess.Popen(
            ["omarchy", "launch", "editor", str(log_path)],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        print(json.dumps({"opened":str(log_path)}, ensure_ascii=False)); return
    if a.command == "status": result=call("GetStatus")
    elif a.command == "transfers": result=call("GetTransfers")
    elif a.command == "sync": result=call("Sync")
    elif a.command == "clear-cache": result=call("ClearCache")
    elif a.command == "clear-pinned-cache": result=call("ClearPinnedCache")
    elif a.command == "pin": result=call("SetPinned", nodeId=a.node_id, pinned=True)
    elif a.command == "unpin": result=call("SetPinned", nodeId=a.node_id, pinned=False)
    elif a.command == "evict": result=call("Evict", nodeId=a.node_id)
    elif a.command == "retry": result=call("Retry", nodeId=a.node_id)
    elif a.command == "node-status": result=call("GetNodeStatus", nodeId=a.node_id)
    elif a.command == "cancel-transfer": result=call("CancelTransfer", transferId=a.transfer_id)
    elif a.command.startswith("conflict-"):
        resolution=a.command.removeprefix("conflict-"); params={"nodeId":a.node_id, "resolution":resolution}
        if a.name: params["copyName"]=a.name
        result=call("ResolveConflict", **params)
    elif a.command == "open":
        mount=a.path or os.environ.get("OMARCHY_DRIVE_MOUNT", str(DATA_HOME/"omarchy-drive/mount")); subprocess.Popen(["nautilus", mount], start_new_session=True); result={"opened":mount}
    print(json.dumps(result, ensure_ascii=False))
if __name__ == "__main__":
    try: main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc: print(json.dumps({"error":str(exc)}), file=sys.stderr); raise SystemExit(1)
